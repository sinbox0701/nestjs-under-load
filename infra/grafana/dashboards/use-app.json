          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"app\"}[$__rate_interval])) / on (name) group_left sum by (name) (container_spec_cpu_quota{container_label_com_docker_compose_service=\"app\"} / container_spec_cpu_period{container_label_com_docker_compose_service=\"app\"})",
          "legendFormat": "{{name}}",
