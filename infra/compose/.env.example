# 로컬 전용 기본값. 실제 비밀 정보가 아니다(DESIGN §13). 바꾸려면 이 파일을 .env로 복사해 수정.
POSTGRES_SUPERUSER_PASSWORD=postgres_local
LAB_APP_PASSWORD=lab_app_local
LAB_OBSERVER_PASSWORD=lab_observer_local
EXPORTER_PASSWORD=exporter_local
GRAFANA_ADMIN_PASSWORD=grafana_local

# cpuset(D9): Docker Desktop VM 의 vCPU 14개 기준 기본값. vCPU 가 14개보다 적으면 없는 CPU 번호 때문에
# 컨테이너가 뜨지 않을 수 있다. 그때는 값을 실제 vCPU 에 맞추거나, 아래 다섯 줄을 `CPUSET_K6=` 처럼
# 비워 둔다(cpuset 없음, cpus 제한만 적용, 실행 메타데이터에 cpuset: none 이 남는다).
# 이 상태의 결과는 기본값 상태의 결과와 비교하지 않는다.
# k6 | app+nginx | postgres+redis | 관측 스택 | 제어(orchestrator·socket-proxy·web)
CPUSET_K6=0-1
CPUSET_APP=2-5
CPUSET_DB=6-8
CPUSET_OBS=9-11
CPUSET_CTL=12-13

# RunConfig 전달 방식. 설정하지 않으면 기본값(http://orchestrator:4001, 오케스트레이터에서 HTTP 로 받음)을 쓴다.
# 비우면(`ORCHESTRATOR_URL=`) app 이 파일(runs/_active/run-config.json)을 읽는다 — 0단계 scripts/run.mjs 경로.
# 화면·API 경로에서는 설정하지 않는다.
# ORCHESTRATOR_URL=

# 프로젝트 이름. 기본 nestjs-under-load. `docker compose -p <이름>` 으로 바꿔 띄우면 같은 값을 여기에도 둔다
# (오케스트레이터의 app 컨테이너 조회 라벨, Alloy 로그 필터가 이 값을 쓴다).
# COMPOSE_PROJECT_NAME=nestjs-under-load

# git worktree 에서 띄울 때만(오케스트레이터가 /repo 의 git 을 못 읽는 경우의 폴백). 일반 clone 에서는 필요 없다.
# 호스트에서 export 해도 된다. 미지정이면 sha 는 unknown.
# GIT_SHA=<git rev-parse HEAD>
# GIT_DIRTY=false
