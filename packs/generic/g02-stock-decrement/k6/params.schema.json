{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G02 k6 parameters (passed as k6 -e KEY=VALUE)",
  "type": "object",
  "properties": {
    "BASE_URL": { "type": "string", "default": "http://nginx" },
    "PHASE": { "enum": ["warmup", "main"], "default": "main" },
    "RATE": { "type": "integer", "minimum": 1, "default": 100, "description": "iterations per second (open model)" },
    "DURATION": { "type": "string", "pattern": "^[0-9]+[smh]$", "default": "30s" },
    "PRE_VUS": { "type": "integer", "minimum": 1, "default": 50 },
    "MAX_VUS": { "type": "integer", "minimum": 1, "default": 200, "description": "maxVUs >= rate x request timeout 이어야 dropped_iterations를 SUT 실패로 해석할 수 있다" },
    "PRODUCT_MIN": { "type": "integer", "minimum": 1, "default": 1 },
    "PRODUCT_MAX": { "type": "integer", "minimum": 1, "default": 5 },
    "QTY": { "type": "integer", "minimum": 1, "default": 1 },
    "REQUEST_TIMEOUT": { "type": "string", "default": "10s" },
    "SUMMARY_PATH": { "type": "string", "description": "handleSummary JSON 출력 경로(k6 컨테이너 기준)" }
  },
  "additionalProperties": false
}
