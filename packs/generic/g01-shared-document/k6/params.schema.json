{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G01 k6 parameters (passed as k6 -e KEY=VALUE, C7 공통 키 + G01 전용 키)",
  "type": "object",
  "properties": {
    "BASE_URL": { "type": "string", "default": "http://nginx" },
    "PHASE": { "enum": ["warmup", "main"], "default": "main" },
    "RUN_ID": { "type": "string", "default": "" },
    "MODEL": { "enum": ["open", "closed"], "default": "closed", "description": "closed=constant-vus(G01 기본), open=constant-arrival-rate. 템플릿 자체는 env 가 없으면 lib 기본값 open 으로 동작하므로 실행기가 MODEL 을 항상 넘긴다" },
    "RATE": { "type": "integer", "minimum": 1, "default": 100, "description": "iterations per second (open model)" },
    "VUS": { "type": "integer", "minimum": 1, "default": 50, "description": "동시 VU 수 = 같은 문서를 다투는 사람 수 (closed model)" },
    "DURATION": { "type": "string", "pattern": "^[0-9]+[smh]$", "default": "30s" },
    "PRE_VUS": { "type": "integer", "minimum": 1, "default": 50 },
    "MAX_VUS": { "type": "integer", "minimum": 1, "default": 200, "description": "maxVUs >= rate x request timeout 이어야 dropped_iterations를 SUT 실패로 해석할 수 있다" },
    "THINK_MIN_MS": { "type": "integer", "minimum": 0, "default": 0 },
    "THINK_MAX_MS": { "type": "integer", "minimum": 0, "default": 0 },
    "DIST": { "enum": ["uniform", "zipf"], "default": "uniform", "description": "문서 선택 분포" },
    "ZIPF_S": { "type": "number", "exclusiveMinimum": 0, "default": 1.1 },
    "SEED": { "type": "integer", "default": 42 },
    "REP_ACTORS": { "type": "integer", "minimum": 0, "default": 8, "description": "VU 번호가 이 값 이하이면 traceparent 샘플 플래그 01" },
    "REQUEST_TIMEOUT": { "type": "string", "default": "10s" },
    "SUMMARY_PATH": { "type": "string", "description": "handleSummary JSON 출력 경로(k6 컨테이너 기준)" },
    "DOC_MIN": { "type": "integer", "minimum": 1, "default": 1 },
    "DOC_MAX": { "type": "integer", "minimum": 1, "default": 5 },
    "EDIT_MS": { "type": "integer", "minimum": 0, "default": 50, "description": "GET 뒤 저장 전까지의 편집 시간(ms). edit-lease에서는 잠금 보유 시간" },
    "STRATEGY": {
      "enum": ["naive-overwrite", "blind-retry", "optimistic-version", "field-merge", "edit-lease"],
      "default": "optimistic-version",
      "description": "클라이언트 동작을 정한다. 서버가 같은 strategy로 떠 있어야 의미가 있다"
    },
    "LEASE_RETRY_MS": { "type": "integer", "minimum": 1, "default": 20, "description": "edit-lease acquire가 423일 때 재시도 간격(ms)" }
  },
  "additionalProperties": false
}
