{
  "name": "@under-load/app",
  "version": "0.0.0",
  "private": true,
  "description": "실험 대상 NestJS + MikroORM 앱 (부팅 시 RunConfig로 시나리오·strategy 선택)",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "start": "node dist/main.js",
    "prepare-template": "node dist/cli/prepare-template.js"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.3",
    "@mikro-orm/decorators": "7.2.3",
    "@mikro-orm/migrations": "7.2.3",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "7.2.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.69.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@under-load/contracts": "workspace:*",
    "@under-load/g01-shared-document": "workspace:*",
    "@under-load/g02-stock-decrement": "workspace:*",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
